__pycache__/
.pytest_cache/

# תוצרי בנייה מקומיים של PyInstaller
build/
dist/
*.spec
# מרשם הבנייה הרשמי הוא קוד מקור — הוא מה שמשאיר את ה-EXE קטן, ובלעדיו
# זרימת ה-Release נכשלת.
!OrechMenachem.spec

# תעודות חתימה — קובץ pfx/p12 מכיל מפתח פרטי, ומי שמשיג אותו יכול לחתום
# בשמנו על כל קובץ. הן עולות ל-GitHub כסוד (SIGNING_CERT_BASE64) ולא לכאן.
*.pfx
*.p12
*.key
# גם ה-base64 של התעודה הוא המפתח הפרטי — base64 אינו הצפנה. התבנית
# הכללית חוסמת כל קובץ עזר כזה, לא רק שם אחד מסוים.
*base64*
*.b64